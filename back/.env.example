NODE_ENV=development
# 127.0.0.1: só a própria máquina acessa a API. Em container/produção, use 0.0.0.0.
HOST=127.0.0.1
PORT=3333

DATABASE_URL="postgresql://sefiteam:sefiteam@127.0.0.1:5432/sefiteam?schema=public"

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Em produção, a API não sobe com o valor de exemplo abaixo.
JWT_SECRET="troque-isto-por-um-segredo-com-pelo-menos-32-caracteres"
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:5173

# Admin criado pelo seed (npm run db:seed). A senha precisa ter pelo menos 16 caracteres:
# o seed recusa o valor de exemplo abaixo de propósito.
ADMIN_LOGIN=ADMIN
ADMIN_SENHA="troque-isto"

# Swagger em /docs (deixe false em produção)
SWAGGER_ENABLED=true
